{
  "name": "@w6w/sdk",
  "version": "0.12.0",
  "description": "Typed client for the w6w HTTP API. Thin transport, auth and error mapping — nothing else.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w6w-io/w6w-wrappers.git",
    "directory": "node"
  },
  "homepage": "https://github.com/w6w-io/w6w-wrappers/tree/main/node#readme",
  "bugs": "https://github.com/w6w-io/w6w-wrappers/issues",
  "keywords": [
    "w6w",
    "workflow",
    "sdk",
    "client",
    "api"
  ],
  "type": "module",
  "types": "./dist/mod.d.ts",
  "main": "./dist/mod.js",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./console": {
      "types": "./dist/src/console/mod.d.ts",
      "import": "./dist/src/console/mod.js"
    },
    "./server": {
      "types": "./dist/src/server/mod.d.ts",
      "import": "./dist/src/server/mod.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/**/*_test.ts\"",
    "cov": "node --test --experimental-test-coverage \"tests/**/*_test.ts\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.19.2",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
