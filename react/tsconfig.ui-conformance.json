{
  // Type-only CI gate: compiles ONLY `ui-conformance.check.ts` against the
  // in-repo MOCK of `@w6w/ui` (`test/mocks/ui`, mapped by `paths` below), so
  // react's unit suite never depends on the real ui (R-8). The real-ui check
  // is the monorepo's `deploy/verify-cross.sh`. `ui-conformance.test.ts` runs this project
  // via `node_modules/typescript/bin/tsc` and asserts exit 0.
  //
  // `extends` the published build config so this check compiles under the
  // SAME compiler options the real build uses (jsx, module, strict, …);
  // `include`/`exclude` below replace rather than merge with the base
  // config's, which is what makes `noEmit`-ing just the one check file
  // possible without also emitting (or needing) the whole `src/` tree.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@w6w/ui": ["./test/mocks/ui/index.ts"],
      "@w6w/ui/flow": ["./test/mocks/ui/flow.ts"]
    }
  },
  "include": ["src/__tests__/ui-conformance.check.ts"],
  "exclude": []
}
